file: fix UTF-8 file names in directory listings and downloads

The directory listing was sent as "text/html" without a charset, so
clients defaulted to ISO-8859-1 (or their local code page) and showed
UTF-8 file names as mojibake.  Announce UTF-8 both in the Content-Type
header and through a meta tag in the generated document.

Percent-encode path segments in the links of the listing so that
non-ASCII names, '#', '?' and spaces produce valid URLs.  Without this,
clients that do not auto-encode raw UTF-8 bytes build broken requests,
and '#' truncates the URL at the fragment.

For non-ASCII file names also emit a Content-Disposition header with an
RFC 5987 filename* parameter.  Download managers can then decode the
name as UTF-8 instead of guessing the local code page; the quoted
filename fallback keeps the raw UTF-8 bytes for older clients, with
control characters, quotes and backslashes replaced by '_'.
---

--- a/file.c
+++ b/file.c
@@ -386,6 +386,59 @@
 	ustream_printf(cl->us, "Content-Length: 0\r\n\r\n");
 }
 
+static void uh_file_send_disposition(struct client *cl, const char *path)
+{
+	const char *name;
+	char *fallback = NULL, *encoded = NULL;
+	size_t len, i;
+	int out_len;
+	bool non_ascii = false;
+
+	name = strrchr(path, '/');
+	name = name ? name + 1 : path;
+	len = strlen(name);
+
+	if (!len)
+		return;
+
+	for (i = 0; i < len; i++) {
+		if ((unsigned char)name[i] >= 0x80) {
+			non_ascii = true;
+			break;
+		}
+	}
+
+	if (!non_ascii)
+		return;
+
+	fallback = malloc(len + 1);
+	encoded = malloc(len * 3 + 1);
+
+	if (!fallback || !encoded)
+		goto out;
+
+	for (i = 0; i < len; i++) {
+		unsigned char c = name[i];
+
+		fallback[i] = (c < 0x20 || c == 0x7f ||
+			       c == '"' || c == '\\') ? '_' : c;
+	}
+	fallback[len] = 0;
+
+	out_len = uh_urlencode(encoded, len * 3 + 1, name, len);
+	if (out_len < 0)
+		goto out;
+	encoded[out_len] = 0;
+
+	ustream_printf(cl->us,
+		"Content-Disposition: inline; filename=\"%s\"; filename*=UTF-8''%s\r\n",
+		fallback, encoded);
+
+out:
+	free(fallback);
+	free(encoded);
+}
+
 static void uh_file_response_304(struct client *cl, struct stat *s)
 {
 	uh_http_header(cl, 304, "Not Modified");
@@ -514,6 +567,41 @@
 	return alphasort(a, b);
