+static char *uh_file_urlencode(const char *str, bool path)
+{
+	size_t len = strlen(str);
+	char *encoded;
+	int out_len;
+
+	encoded = malloc(len * 3 + 1);
+	if (!encoded)
+		return NULL;
+
+	out_len = uh_urlencode(encoded, len * 3 + 1, str, len);
+	if (out_len < 0) {
+		free(encoded);
+		return NULL;
+	}
+	encoded[out_len] = 0;
+
+	if (path) {
+		char *src, *dst;
+
+		for (src = dst = encoded; *src; src++) {
+			if (src[0] == '%' && src[1] == '2' && src[2] == 'f') {
+				*dst++ = '/';
+				src += 2;
+			} else {
+				*dst++ = *src;
+			}
+		}
+
+		*dst = 0;
+	}
+
+	return encoded;
+}
